.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
dist/
build/
.cache/
*.egg-info/

# Machine-local paths (dataset archives, GPU id). Never commit.
configs/local.json

# Dedicated local dataset tree (images, archives, catalogs). Keep the READMEs.
datasets/**
!datasets/README.md
!datasets/README.zh-CN.md

# Local datasets, derived assets, and indices. Keep README and placeholders.
data/**
!data/README.md
!data/README.zh-CN.md
!data/raw/
!data/interim/
!data/processed/
!data/exports/
!data/manifests/
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/exports/.gitkeep
!data/manifests/.gitkeep

# Local model checkouts and weights.
models/**
!models/.gitkeep

# Training, eval, and weights stay ignored.
# outputs/runs/ is the committed score record.
# outputs/reports/ is local agent handoff prose. Ignore the directory, not each file.
outputs/**
!outputs/.gitkeep
!outputs/runs/
!outputs/runs/**
!outputs/warmup/
!outputs/warmup/*.json

# Safety net for weights, embeddings, and search indices.
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.ggml
*.onnx
*.h5
*.npz
*.npy
*.faiss
*.idx
*.arrow
*.parquet
*.feather
